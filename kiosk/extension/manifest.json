{
  "manifest_version": 3,
  "name": "Autodarts Kiosk Controls",
  "version": "1.0.0",
  "description": "Switches between Autodarts Play and the local Board Manager.",
  "host_permissions": ["http://127.0.0.1:3182/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://play.autodarts.io/*"],
      "js": ["websocket-capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://play.autodarts.io/*"],
      "js": ["capture-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://play.autodarts.io/*",
        "http://127.0.0.1:3180/*"
      ],
      "js": ["controls.js"],
      "run_at": "document_end"
    }
  ]
}
